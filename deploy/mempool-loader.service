# /etc/systemd/system/mempool-loader.service
[Unit]
Description=Mempool loader (CSV -> Postgres/TimescaleDB)
After=network-online.target postgresql.service
Wants=postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=mempool
WorkingDirectory=/opt/mempool-collector
EnvironmentFile=/opt/mempool-collector/.env
ExecStart=/opt/mempool-collector/.venv/bin/python loader.py
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
